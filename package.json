    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "next": "^16.3.1",
    "postcss": "^8.5.26",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3"
